{
  "name": "physics-wallah",
  "version": "1.0.0",
  "description": "Official Physics Wallah Desktop Application for online classes and interactive learning.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.physicswallah.desktop",
    "productName": "Physics Wallah",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    }
  }
}
